# Optional. Without a key the backend answers with the offline extractive model.
OPENAI_API_KEY=
# Any OpenAI-compatible endpoint, e.g. http://localhost:11434/v1 for Ollama.
OPENAI_BASE_URL=
LLM_MODEL=gpt-4o-mini
# With a key set, embeddings switch on hybrid (keyword + vector) retrieval.
EMBEDDING_MODEL=text-embedding-3-small
# Optional cross-encoder reranking; needs backend/requirements-rerank.txt.
# RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
